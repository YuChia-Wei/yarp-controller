{
  "ReverseProxy": {
    "Routes": {
      "httpbin-route": {
        "ClusterId": "httpbin-cluster",
        "AuthorizationPolicy": "Default",
        "CorsPolicy": "CorsPolicy",
        "Match": {
          "Path": "/httpbin/{**catchall}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/httpbin"
          }
        ]
      }
    }
  }
}